#!name = 📺 BiliBili: 🛡️ ADBlock (Rewrite)
#!desc = 哔哩哔哩：去广告\n自定义去除APP内界面元素
#!openUrl = http://boxjs.com/#/app/BiliBili.ADBlock
#!author = ClydeTime[https://github.com/ClydeTime],VirgilClyne[https://github.com/VirgilClyne],app2smile[https://github.com/app2smile],RuCu6[https://github.com/RuCu6],Maasea[https://github.com/Maasea]
#!homepage = https://ADBlock.BiliUniverse.io
#!icon = https://github.com/BiliUniverse/ADBlock/raw/main/src/assets/icon_rounded.png
#!category = 🪐 BiliUniverse

[Map Local]
# 去除搜索中的大家都在搜
^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words data-type=text data="{}" header="application/json"
# 去除动态中的话题
^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr data-type=text data="{}" header="application/json"
# 去除动态中的最常访问
^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist data-type=text data="{}" header="application/json"
# BiliBili漫画去广告
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash data-type=text data="{}" header="application/json"
^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash data-type=text data="{}" header="application/json"
^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? data-type=text data="{}" header="application/json"
# 番剧页可能弹出的HTML广告
^https:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive\? header="content-type: application/json" data-type=text data="{\"code\":0,\"data\":{\"closeType\":\"close_win\",\"container\":[],\"showTime\":\"\"},\"message\":\"success\"}"

[Body Rewrite]
# iPad端番剧推荐列表上方广告
http-response-jq ^https:\/\/api\.bilibili\.com\/pgc\/view\/v2\/app\/season\? 'del(.data.payment)'

[URL Rewrite]
# 去除搜索中的默认关键词
^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ - reject
# 重定向 JSON 接口到 app.nanocat.cloud
^https?:\/\/app\.bili(bili\.com|api\.net)\/(x\/v2\/(?:splash\/(?:brand\/list|event\/list2|list|show)|feed\/index(?:\/story)?|search\/square)(?:\?.*)?)$ https://app.nanocat.cloud/$2 header
^https?:\/\/api\.bili(bili\.com|api\.net)\/(x\/web-interface\/wbi\/index\/top\/feed\/rcmd(?:\?.*)?)$ https://app.nanocat.cloud/$2 header
^https?:\/\/api\.bili(bili\.com|api\.net)\/(pgc\/page\/(?:bangumi|cinema\/tab)(?:\?.*)?)$ https://app.nanocat.cloud/$2 header
^https?:\/\/api\.live\.bilibili\.com\/(xlive\/app-room\/v1\/index\/getInfoByRoom(?:\?.*)?)$ https://app.nanocat.cloud/$1 header
# 重定向 app gRPC 接口到 app.nanocat.cloud
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.(?:view|viewunite)\.v1\.View\/(?:View|TFInfo|RelatesFeed))$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(?:All|Video))$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.playurl\.v1\.PlayURL\/PlayView)$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile))$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus)$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.main\.community\.reply\.v1\.Reply\/MainList)$ https://app.nanocat.cloud/$2 header
^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$ https://app.nanocat.cloud/$2 header
# 重定向 grpc 接口到 grpc.nanocat.cloud
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.(?:view|viewunite)\.v1\.View\/(?:View|TFInfo|RelatesFeed))$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(?:All|Video))$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.playurl\.v1\.PlayURL\/PlayView)$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile))$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus)$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.main\.community\.reply\.v1\.Reply\/MainList)$ https://grpc.nanocat.cloud/$2 header
^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$ https://grpc.nanocat.cloud/$2 header

[MITM]
hostname = manga.bilibili.com, api.live.bilibili.com, api.vc.bilibili.com, app.bilibili.com, app.biliapi.net, api.bilibili.com, api.biliapi.net, grpc.biliapi.net, grpc.bilibili.com
h2 = true
