name: "📺 BiliBili: 🛡️ ADBlock (Rewrite)"
desc: |-
  哔哩哔哩：去广告
  自定义去除APP内界面元素
openUrl: "http://boxjs.com/#/app/BiliBili.ADBlock"
author: |-
  ClydeTime[https://github.com/ClydeTime]
  VirgilClyne[https://github.com/VirgilClyne]
  app2smile[https://github.com/app2smile]
  RuCu6[https://github.com/RuCu6]
  Maasea[https://github.com/Maasea]
homepage: "https://biliverse.github.io/guide/ad-block"
icon: "https://github.com/Biliverse/ADBlock/raw/main/src/assets/icon_rounded.png"
category: "🪐 Biliverse"

http:
  mitm:
    - "manga.bilibili.com"
    - "api.live.bilibili.com"
    - "api.vc.bilibili.com"
    - "app.bilibili.com"
    - "app.biliapi.net"
    - "api.bilibili.com"
    - "api.biliapi.net"
    - "grpc.biliapi.net"
    - "grpc.bilibili.com"
  url-rewrite:
    # 去除搜索中的默认关键词
    - ^https?:\/\/(grpc|app)\.bili(bili\.com|api\.net)\/bilibili\.app\.interface\.v1\.Search\/DefaultWords$ - reject
    # 去除搜索中的大家都在搜
    - ^https?:\/\/api\.vc\.bilibili\.com\/search_svr\/v\d\/Search\/recommend_words - reject-dict
    # 去除动态中的话题
    - ^https?:\/\/api\.vc\.bilibili\.com\/topic_svr\/v1\/topic_svr - reject-dict
    # 去除动态中的最常访问
    - ^https?:\/\/api\.vc\.bilibili\.com\/dynamic_svr\/v1\/dynamic_svr\/mix_uplist - reject-dict
    # BiliBili漫画去广告
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/Flash - reject-dict
    - ^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/ListFlash - reject-dict
    - ^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v1\/ecommerce-user\/get_shopping_info\? - reject-dict
    # 重定向 JSON 接口到 app.nanocat.cloud
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(x\/v2\/(?:splash\/(?:brand\/list|event\/list2|list|show)|feed\/index(?:\/story)?|search\/square)(?:\?.*)?)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/api\.bili(bili\.com|api\.net)\/(x\/web-interface\/wbi\/index\/top\/feed\/rcmd(?:\?.*)?)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/api\.bili(bili\.com|api\.net)\/(pgc\/page\/(?:bangumi|cinema\/tab)(?:\?.*)?)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/api\.live\.bilibili\.com\/(xlive\/app-room\/v1\/index\/getInfoByRoom(?:\?.*)?)$ https://app.nanocat.cloud/$1 transparent
    # 重定向 app gRPC 接口到 app.nanocat.cloud
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.(?:view|viewunite)\.v1\.View\/(?:View|TFInfo|RelatesFeed))$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(?:All|Video))$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.playurl\.v1\.PlayURL\/PlayView)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile))$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.main\.community\.reply\.v1\.Reply\/MainList)$ https://app.nanocat.cloud/$2 transparent
    - ^https?:\/\/app\.bili(bili\.com|api\.net)\/(bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$ https://app.nanocat.cloud/$2 transparent
    # 重定向 grpc 接口到 grpc.nanocat.cloud
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.(?:view|viewunite)\.v1\.View\/(?:View|TFInfo|RelatesFeed))$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(?:All|Video))$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.playurl\.v1\.PlayURL\/PlayView)$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll)$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.community\.service\.dm\.v1\.DM\/(?:DmView|DmSegMobile))$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus)$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.main\.community\.reply\.v1\.Reply\/MainList)$ https://grpc.nanocat.cloud/$2 transparent
    - ^https?:\/\/grpc\.bili(bili\.com|api\.net)\/(bilibili\.pgc\.gateway\.player\.v2\.PlayURL\/PlayView)$ https://grpc.nanocat.cloud/$2 transparent
