name: "{{@package 'displayName'}} (Rewrite)"
desc: "{{inline (@package 'description')}}"
homepage: "{{@package 'homepage'}}"
icon: "{{@package 'icon'}}"
http:
  mitm:
    - "biliverse.github.io"
    - "app.bilibili.com"
    - "app.biliapi.net"
    - "api.bilibili.com"
    - "api.biliapi.net"
    - "api.live.bilibili.com"
    - "grpc.biliapi.net"
  url-rewrite:
    - ^https?:\/\/(app\.bili(?:bili\.com|api\.net))\/(x\/v2\/(?:splash\/(?:brand\/list|event\/list2|list|show)|feed\/index(?:\/story)?|search\/square).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/(api\.bili(?:bili\.com|api\.net))\/((?:x\/web-interface\/wbi\/index\/top\/feed\/rcmd|pgc\/page\/(?:bangumi|cinema\/tab)).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/(api\.live\.bilibili\.com)\/(xlive\/app-room\/v1\/index\/getInfoByRoom.*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
    - ^https?:\/\/((?:grpc|app)\.bili(?:bili\.com|api\.net))\/(bilibili\/(?:app\/(?:view|viewunite)\/v1\/View\/(?:View|TFInfo|RelatesFeed)|app\/dynamic\/v2\/Dynamic\/Dyn(?:All|Video)|app\/playurl\/v1\/PlayURL\/PlayView|polymer\/app\/search\/v1\/Search\/SearchAll|community\/service\/dm\/v1\/DM\/(?:DmView|DmSegMobile)|app\/interface\/v1\/Teenagers\/ModeStatus|main\/community\/reply\/v1\/Reply\/MainList|pgc\/gateway\/player\/v2\/PlayURL\/PlayView).*)$ https:\/\/\{{{endpoint}}}\/$1\/$2 transparent
